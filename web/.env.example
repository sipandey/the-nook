# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Supabase — https://app.supabase.com
# Connect Clerk as a third-party auth provider in Authentication > Sign In
# before applying the RLS policies in supabase/migrations/0001_init.sql —
# they key off auth.jwt()->>'sub' being the Clerk user id.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key (Settings > API in the Supabase dashboard) — bypasses
# RLS. Two sanctioned uses, both requiring a genuine cross-user read: the
# cron-triggered daily reminder (src/app/api/cron/daily-reminder/route.ts,
# no per-request user session to scope a normal client to) and NK-13's
# aggregate spend ceiling (src/lib/ai/usage.ts) — see the doc comment on
# getSupabaseServiceRoleClient in src/lib/supabase/server.ts for what
# makes a new use of this key safe. Never expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI — server-only, never exposed to the client (see src/lib/ai/openai.ts)
OPENAI_API_KEY=

# Web Push (VAPID) — for the daily reminder notification cron
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Authenticates that a request to /api/cron/* genuinely came from Vercel
# Cron, not an arbitrary caller — Vercel automatically sends this value as
# `Authorization: Bearer <value>` when it invokes a cron job (see
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs).
# Generate a random string of at least 16 characters.
CRON_SECRET=

# Aggregate daily spend ceiling across every user, all four /api/ai/*
# routes combined (NK-13, docs/ARCHITECTURE.md §10.6.3(c)) — bounds worst
# case, not normal use; per-user hourly limits (src/lib/ai/usage.ts's
# RATE_LIMITS) already exist separately. Optional — defaults to 1 (USD)
# if unset, see checkAggregateSpendCeiling in src/lib/ai/usage.ts.
AI_DAILY_SPEND_CEILING_USD=1

# Sentry — https://sentry.io (production error monitoring, NK-06)
# DSN is not secret (safe to expose client-side per Sentry's own security
# model) but still project-specific — see
# docs/plans/2026-08-25-sentry-error-monitoring-design.md for the full
# data-collection policy this app applies around it. Only actually
# transmits when VERCEL_ENV=production (src/lib/monitoring/sentryEnabled.ts) —
# safe to leave set locally.
NEXT_PUBLIC_SENTRY_DSN=
